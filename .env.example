# Environment of the Binance target runtime (runner/binance_target.py) and its tools.
# Copy to /quant_system/.env, readable by the service user only (chmod 600). Never commit the real file.
# Binance USDT-M perpetuals only; paper mode (--dry-run, the default) needs none of the keys below.
# trading/infrastructure/config.py is the one place that reads these; the start-up logs what it used,
# without the keys, the Telegram values or the heartbeat address.

# --- Network -------------------------------------------------------------------------------------------------
# 1 (default) = Binance testnet. 0 = mainnet; mainnet execution is refused unless the strategy spec passed.
BINANCE_TESTNET=1

# --- Account (execution mode) ----------------------------------------------------------------------------------
# API permissions: read + futures trading. Never enable withdrawals. Bind the key to this host's IP.
# The account identity is sha256(network:API key): one execution process per identity on this host.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
# BINANCE_API_KEY=
# BINANCE_API_SECRET=

# Names the account's risk state; must contain "binance", and "testnet" exactly when BINANCE_TESTNET=1.
# The state directory is initialized for it (python -m trading.infrastructure.state_dir ... init).
# Example: binance-testnet-main on the testnet, binance-main on mainnet.
RISK_SCOPE=

# --- Alerts and heartbeat (required for execution mode, testnet and mainnet) ------------------------------------
# Execution refuses to start without them, and without a confirmed "starting" message on Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# An external monitor's ping address (for example a dead-man's-switch service). Pinged at most once a minute;
# its silence is how a dead host is noticed. Treated as a secret.
HEARTBEAT_URL=

# --- Strategy capital (required for mainnet execution; owner, 2026-11-16) ---------------------------------------
# The strategy shares the main account and sizes from min(account equity, this + its own realized PnL after fees
# + its USDT funding income since its first fill on each symbol). Funding is read from Binance at most every
# 10 minutes; never read, older than 2 hours, or a first fill older than 88 days sizes to zero.
# STRATEGY_CAPITAL_USDT=300
# The strategy loss stop, in per cent of that capital (owner, 2026-11-16): once realized PnL after fees + funding +
# the open positions' unrealized PnL is this far below zero, the runtime sets the kill switch with flatten and a
# person takes over. 15 unless set; it can only be tightened (above 0, at most 15).
# STRATEGY_LOSS_STOP_PCT=15

# --- Exchange settings (checked, never changed by the runtime) -------------------------------------------------
# Start-up refuses when the account's leverage or margin mode differs; set them on Binance by hand.
# BINANCE_EXCHANGE_LEVERAGE=3
# BINANCE_MARGIN_TYPE=CROSSED            # CROSSED or ISOLATED; unset means cross

# --- Risk limits (defaults shown; a person may lower them; drawdown is capped at 10% daily, 25% weekly) --------
# MAX_DAILY_DRAWDOWN_PCT=5
# MAX_WEEKLY_DRAWDOWN_PCT=12
# BINANCE_MAX_ORDER_NOTIONAL=5000
# BINANCE_MAX_DAILY_NOTIONAL=50000
# BINANCE_MAX_DAILY_ORDERS=50
# BINANCE_MAX_LEVERAGE=3

# --- Signed artifacts ------------------------------------------------------------------------------------------
# The key that signs the strategy spec (scripts/publish_strategy_spec.py). Unsigned artifacts are refused on
# mainnet always; QUANT_ALLOW_UNSIGNED_MODELS=1 is for local development on the testnet only.
QUANT_MODEL_SIGN_KEY=
# QUANT_ALLOW_UNSIGNED_MODELS=0
