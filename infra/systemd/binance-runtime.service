[Unit]
Description=Binance USDT-M runtime (PAPER by default; see docs/binance_runbook.md)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/quant_system
EnvironmentFile=/quant_system/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/quant_system
# Paper trading with the research broker. Execution requires, in this order:
#   1. a published, signed model per symbol in models_binance/ (research gate
#      must have PASSED for mainnet), 2. RISK_SCOPE naming binance + testnet/mainnet,
#   3. adding --enable-execution here by a human. BINANCE_TESTNET defaults to 1.
ExecStart=/usr/bin/python3 -m runner.binance_main --models-dir models_binance --symbols BTCUSDT ETHUSDT --dry-run
Restart=on-failure
RestartSec=60
StandardOutput=append:/quant_system/logs/binance_runtime.log
StandardError=append:/quant_system/logs/binance_runtime.log
MemoryMax=1024M

[Install]
WantedBy=multi-user.target
