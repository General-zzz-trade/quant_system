[Unit]
Description=OKX Alpha Strategy H (BTC+ETH 1h+4h, LIVE SWAP) — sibling of binance-alpha
After=network.target binance-alpha.service
# Intentionally not Requires: OKX should run independently; binance-alpha
# failure should NOT cascade to stop OKX.

[Service]
Type=simple
Restart=always
RestartSec=30
WorkingDirectory=/quant_system
EnvironmentFile=/quant_system/.env
Environment=PYTHONPATH=/quant_system
# D13 balanced config: 10x leverage with micro tier_cap (BTC 0.20, ETH 0.10)
# gives effective (2.0x, 1.0x) — portfolio Sharpe +6.36 in 12-month OOS.
# Change with care: lowering tier_cap without lowering leverage increases
# risk; raising both simultaneously amplifies drawdown.
Environment=OKX_LEVERAGE=10
# 10x leverage kill switches — backtest worst day = -4.3%, set 2x buffer
Environment=MAX_DAILY_DRAWDOWN_PCT=8.0
Environment=MAX_WEEKLY_DRAWDOWN_PCT=15.0
# D15 limit-order tuning: tighten offset from 30 bps → 20 bps.  Lower
# offset = more aggressive price = higher fill rate at the cost of
# slightly less favourable prices.  TCA after 30+ fills will tell
# whether 20 is too tight; revert to 30 if unfilled rate spikes.
Environment=LIMIT_OFFSET_BPS=20
# Safety caps: tiny defaults for the first 24h.  Bump these in .env once
# ≥5 successful trades have cleared without any qty/price anomaly.
#   OKX_MAX_ORDER_NOTIONAL=50   (per-order USD cap)
#   OKX_MAX_DAILY_NOTIONAL=500  (daily cumulative cap)
# Sync z-score checkpoints so warmup produces signal-capable preds quickly.
ExecStartPre=/usr/bin/python3 /quant_system/scripts/pre_live_check.py
ExecStartPre=/usr/bin/python3 /quant_system/scripts/sync_zscore_from_batch.py
ExecStart=/usr/bin/python3 -m runner.alpha_main --venue okx --symbols BTCUSDT BTCUSDT_4h ETHUSDT --ws
User=ubuntu
TimeoutStopSec=15
MemoryMax=1024M
CPUQuota=50%
StandardOutput=append:/quant_system/logs/okx_alpha.log
StandardError=append:/quant_system/logs/okx_alpha.log

[Install]
WantedBy=multi-user.target
