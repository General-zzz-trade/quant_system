[Unit]
Description=Bybit Alpha Strategy H (BTC + ETH, 4h primary + 1h scaler)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/quant_system
EnvironmentFile=/quant_system/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/quant_system
ExecStart=/usr/bin/python3 -m runner.alpha_main --venue bybit --symbols BTCUSDT BTCUSDT_4h ETHUSDT --ws
Restart=always
RestartSec=30
RestartPreventExitStatus=73
StandardOutput=append:/quant_system/logs/bybit_alpha.log
StandardError=append:/quant_system/logs/bybit_alpha.log

# Resource limits — shares models with OKX, needs warmup memory
MemoryMax=1024M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
