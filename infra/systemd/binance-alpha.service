[Unit]
Description=Binance Alpha Strategy H (BTC+ETH 1h+4h, demo testnet)
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=30
WorkingDirectory=/quant_system
EnvironmentFile=/quant_system/.env
Environment=PYTHONPATH=/quant_system
# D15 limit-order tuning — match OKX setting for parity diagnostics.
Environment=LIMIT_OFFSET_BPS=20
# Ensures the z-score buffer matches backtest (not incremental) predictions.
# ETHUSDT_4h removed: IC RED for 14+ days, retrain 2x failed, produces noise trades
ExecStart=/usr/bin/python3 -m runner.alpha_main --venue binance --symbols BTCUSDT BTCUSDT_4h ETHUSDT --ws
User=ubuntu
TimeoutStopSec=15
MemoryMax=1024M
CPUQuota=50%
StandardOutput=append:/quant_system/logs/binance_alpha.log
StandardError=append:/quant_system/logs/binance_alpha.log

[Install]
WantedBy=multi-user.target
